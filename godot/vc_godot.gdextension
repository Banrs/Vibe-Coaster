[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.2
reloadable = true

; Both profiles point at target/release deliberately: a debug-profile solve
; takes minutes, and the release ride is the one the CLI writes.
[libraries]
macos.debug = "res://../target/release/libvc_godot.dylib"
macos.release = "res://../target/release/libvc_godot.dylib"
linux.debug.x86_64 = "res://../target/release/libvc_godot.so"
linux.release.x86_64 = "res://../target/release/libvc_godot.so"
windows.debug.x86_64 = "res://../target/release/vc_godot.dll"
windows.release.x86_64 = "res://../target/release/vc_godot.dll"
